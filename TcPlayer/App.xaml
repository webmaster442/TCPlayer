<Application
    x:Class="TcPlayer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TcPlayer"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  App colors & fonts  -->
                <ResourceDictionary Source="Styles/ColorsAndFonts.xaml" />
                <!--  Base control styles  -->
                <ResourceDictionary Source="Styles/BaseControlStyles.xaml" />
                <!--  Custom control styles  -->
                <ResourceDictionary Source="Styles/WindowControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

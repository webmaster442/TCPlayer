<local:SingleInstanceApp
    x:Class="TcPlayer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TcPlayer"
    AppId="A5FC27CF-EB3F-4CC7-8886-A2F549B46F3A-TcPlayer3"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  App colors & fonts  -->
                <ResourceDictionary Source="Styles/ColorsAndFonts.xaml" />
                <!--  Base control styles  -->
                <ResourceDictionary Source="Styles/BaseControlStyles.xaml" />
                <!--  Data templates  -->
                <ResourceDictionary Source="Styles/DataTemplates.xaml" />
                <!--  Custom control styles  -->
                <ResourceDictionary Source="Styles/WindowControls.xaml" />
                <ResourceDictionary Source="Styles/BusyIndicator.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</local:SingleInstanceApp>

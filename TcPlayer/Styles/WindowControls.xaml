<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TcPlayer.Controls">
    <Style TargetType="controls:WindowControls">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:WindowControls">
                    <Border
                        x:Name="PART_Border"
                        Background="{StaticResource WindowControl}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Margin="5,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Text="{Binding Path=ControlledWindow.Title, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type controls:WindowControls}}}" />
                            <ToggleButton
                                x:Name="PART_Pin"
                                Grid.Column="1"
                                Margin="2,0"
                                Width="30">
                                <ToggleButton.Style>
                                    <Style
                                        BasedOn="{StaticResource Transparent}"
                                        TargetType="ToggleButton">
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <Canvas
                                                            Width="24"
                                                            Height="24">
                                                            <Path
                                                                Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12M8.8,14L10,12.8V4H14V12.8L15.2,14H8.8Z"
                                                                Fill="{StaticResource ButtonColor}" />
                                                        </Canvas>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <Canvas
                                                            Width="24"
                                                            Height="24">
                                                            <Path
                                                                Data="M8,6.2V4H7V2H17V4H16V12L18,14V16H17.8L14,12.2V4H10V8.2L8,6.2M20,20.7L18.7,22L12.8,16.1V22H11.2V16H6V14L8,12V11.3L2,5.3L3.3,4L20,20.7M8.8,14H10.6L9.7,13.1L8.8,14Z"
                                                                Fill="{StaticResource ButtonColor}" />
                                                        </Canvas>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Button
                                x:Name="PART_Minimize"
                                Grid.Column="2"
                                Margin="2,0"
                                Style="{StaticResource Transparent}"
                                Width="30">
                                <Button.Content>
                                    <Canvas
                                        Width="24"
                                        Height="24">
                                        <Path
                                            Data="M20,14H4V10H20"
                                            Fill="{StaticResource ButtonColor}" />
                                    </Canvas>
                                </Button.Content>
                            </Button>
                            <ToggleButton
                                x:Name="PART_Maximize"
                                Grid.Column="3"
                                Margin="2,0"
                                Width="30">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource Transparent}">
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <Canvas
                                                            Width="24"
                                                            Height="24">
                                                            <Path
                                                                Data="M4,4H20V20H4V4M6,8V18H18V8H6Z"
                                                                Fill="{StaticResource ButtonColor}" />
                                                        </Canvas>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <Canvas
                                                            Width="24"
                                                            Height="24">
                                                            <Path
                                                                Data="M4,8H8V4H20V16H16V20H4V8M16,8V14H18V6H10V8H16M6,12V18H14V12H6Z"
                                                                Fill="{StaticResource ButtonColor}" />
                                                        </Canvas>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Button
                                Margin="2,0"
                                x:Name="PART_Close"
                                Grid.Column="4"
                                Style="{StaticResource Transparent}"
                                Width="30">
                                <Button.Content>
                                    <Canvas
                                        Width="24"
                                        Height="24">
                                        <Path
                                            Data="M13.46,12L19,17.54V19H17.54L12,13.46L6.46,19H5V17.54L10.54,12L5,6.46V5H6.46L12,10.54L17.54,5H19V6.46L13.46,12Z"
                                            Fill="{StaticResource Red}" />
                                    </Canvas>
                                </Button.Content>
                            </Button>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
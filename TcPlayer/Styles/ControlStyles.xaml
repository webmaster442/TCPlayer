<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TcPlayer.Controls">
    <Style TargetType="controls:WindowControls">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:WindowControls">
                    <Border
                        x:Name="PART_Border"
                        Background="{StaticResource WindowControl}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Margin="5,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding Path=ControlledWindow.Title, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type controls:WindowControls}}}" />
                            <ToggleButton
                                x:Name="PART_Pin"
                                Grid.Column="1"
                                Width="50">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter Property="Content" Value="Pin" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Content" Value="UnPin" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Button
                                x:Name="PART_Minimize"
                                Grid.Column="2"
                                Width="30"
                                Content="_" />
                            <Button
                                x:Name="PART_Maximize"
                                Grid.Column="3"
                                Width="30"
                                Content="^" />
                            <Button
                                x:Name="PART_Close"
                                Grid.Column="4"
                                Width="30"
                                Content="X" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
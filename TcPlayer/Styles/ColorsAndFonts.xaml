<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush
        x:Key="Color1"
        Color="#0FA3B1" />
    <SolidColorBrush
        x:Key="Color2"
        Color="#B5E2FA" />
    <SolidColorBrush
        x:Key="Background"
        Color="#F9F7F3" />
    <SolidColorBrush
        x:Key="ButtonColor"
        Color="#EDDEA4" />
    <SolidColorBrush
        x:Key="WindowControl"
        Color="#F7A072" />
    <SolidColorBrush
        x:Key="Red"
        Color="#FF0000" />

    <!-- Titles -->
    <FontFamily x:Key="TileFont">pack://application:,,,/Fonts/#Merriweather Sans</FontFamily>

    <!-- Normal text -->
    <FontFamily x:Key="TextFont">pack://application:,,,/Fonts/#Noto Sans ExtraLight</FontFamily>
   
</ResourceDictionary>
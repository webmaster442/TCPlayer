<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TcPlayer.Controls"
    xmlns:converters="clr-namespace:TcPlayer.Converters">
    <Style TargetType="controls:BusyIndicator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:BusyIndicator">
                    <Grid Background="#Af000000">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="25*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25*" />
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="25*" />
                        </Grid.RowDefinitions>
                        <ProgressBar
                            Grid.Row="1"
                            Grid.Column="1"
                            IsIndeterminate="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=controls:BusyIndicator}, Path=Visibility, Converter={converters:VisibilityToBooleanConverter}}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="24"
                            Foreground="WhiteSmoke"
                            Text="{TemplateBinding Message}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
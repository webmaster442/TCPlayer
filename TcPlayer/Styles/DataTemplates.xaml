<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="clr-namespace:TcPlayer.ViewModels">

    <DataTemplate DataType="{x:Type viewmodels:AddUrlViewModel}">
        <TextBox
            MinWidth="400"
            MinHeight="25"
            Margin="5"
            FontSize="22"
            Text="{Binding Url}" />
    </DataTemplate>

</ResourceDictionary>